<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets .NET Framework 4.8, which ships with Windows 10 1903+ and Windows 11,
    so the release is a single small exe with no runtime to install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FastSnip</AssemblyName>
    <RootNamespace>FastSnip</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FastSnip.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>FastSnip</Product>
    <Description>Instant screenshot tool with pixel-exact pencil</Description>
    <Copyright>Copyright © 2026 naterliu1115</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="Assets\FastSnip.ico" LogicalName="FastSnip.ico" />
  </ItemGroup>

</Project>
